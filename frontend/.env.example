NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project

# SMTP (contact + employment application forms)
# Required for any page using the `contactForm` page-builder block — without these, /api/contact returns 500.
SMTP_HOST="" # e.g. smtp.gmail.com, smtp.office365.com
SMTP_PORT="587" # 587 for STARTTLS, 465 for implicit TLS
SMTP_USER="" # SMTP auth username (often the sender email)
SMTP_PASS="" # SMTP auth password / app password
SMTP_FROM="" # From address shown to recipients; falls back to SMTP_USER if blank
CONTACT_FORM_TO_EMAIL="" # Where contact + application emails are delivered
